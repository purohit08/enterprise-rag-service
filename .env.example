# Copy to .env and fill in your keys (.env is gitignored — never commit real keys)

# Claude Opus 4.8 — all LLM reasoning (RAG answers, LLM-as-Judge, scoring/ranking)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — embeddings only (text-embedding-3-small); Claude has no embeddings API
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI-compatible base URL (proxy/gateway). Leave unset for api.openai.com.
# OPENAI_BASE_URL=https://aibe.mygreatlearning.com/openai/v1

# Optional: workspace ID if your Anthropic key is not workspace-scoped
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
